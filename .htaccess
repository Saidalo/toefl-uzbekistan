PassengerAppRoot "/home/wwwwtoefl/domains/toefl-test.uz/public_html"
PassengerBaseURI "/"
PassengerNodejs "/home/wwwtoefl/nodevenv/domains/toefl-test.uz/public_html/16/bin/node"
PassengerAppType node
PassengerStartupFile /home/wwwtoefl/domains/toefl-test.uz/public_html/src/main.ts
PassengerAppLogFile "/home/wwwtoefl/domains/toefl-test.uz/public_html/passenger.log"
